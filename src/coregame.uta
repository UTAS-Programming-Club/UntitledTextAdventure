namespace Core;

enum ScreenDirection {
  North,
  East,
  South,
  West
}

Action GoDirectionAction {
  enum ScreenDirection direction;

  override bool IsVisible(const GameInfo info) {
    switch (this.direction) {
      case Core_ScreenDirection_North:
        if (NULL != backend_get_map_room(info, info.x, info.y + 1)) {
          return true;
        }
        break;
      case Core_ScreenDirection_East:
        if (NULL != backend_get_map_room(info, info.x + 1, info.y)) {
          return true;
        }
        break;
      case Core_ScreenDirection_South:
        if (NULL != backend_get_map_room(info, info.x, info.y - 1)) {
          return true;
        }
        break;
      case Core_ScreenDirection_West:
        if (NULL != backend_get_map_room(info, info.x - 1, info.y)) {
          return true;
        }
        break;
    }

    return false;
  }

  override bool HandleAction(GameInfo info) {
    switch (this.direction) {
      case Core_ScreenDirection_North:
        if (NULL != backend_get_map_room(info, info.x, info.y + 1)) {
          ++info.y;
        }
        break;
      case Core_ScreenDirection_East:
        if (NULL != backend_get_map_room(info, info.x + 1, info.y)) {
          ++info.x;
        }
        break;
      case Core_ScreenDirection_South:
        if (NULL != backend_get_map_room(info, info.x, info.y - 1)) {
          --info.y;
        }
        break;
      case Core_ScreenDirection_West:
        if (NULL != backend_get_map_room(info, info.x - 1, info.y)) {
          --info.x;
        }
        break;
    }

    return true;
  }
}

Action GotoScreenAction {
  Screen screen;

  override bool HandleAction(GameInfo info) {
    info.screen = this.screen;
    return true;
  }
}

Action QuitAction {
  override bool HandleAction(GameInfo info) {
    info.quit = true;
    return true;
  }
}

Screen RoomScreen {
  // TODO: Support core_room_screen_body_generator
}


Screen MainMenuScreen;
Screen RoomScreen;


Action GoNorthAction = GoDirectionAction("Go North", North);
Action GoEastAction = GoDirectionAction("Go East", East);
Action GoSouthAction = GoDirectionAction("Go South", South);
Action GoWestAction = GoDirectionAction("Go West", West);

Action StartGameAction = GotoScreenAction("Start Game", RoomScreen);
Action GotoMainMenuAction = GotoScreenAction("Quit", MainMenuScreen);

Action QuitAction = QuitAction("Quit Game");


Room FirstRoom = Room(0, 0, "First Room!");


// TODO: Support multi-line strings
Screen MainMenuScreen = Screen("Untitled text adventure game", { StartGameAction, QuitAction });
Screen RoomScreen = RoomScreen("Room screen!", { GoNorthAction, GoEastAction, GoSouthAction, GoWestAction, GotoMainMenuAction });
